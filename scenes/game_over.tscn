[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/game_over.gd" id="1_game_over"]
[ext_resource type="FontFile" path="res://assets/fonts/title_font.ttf" id="2_title_font"]
[ext_resource type="FontFile" path="res://assets/fonts/ui_font.ttf" id="3_ui_font"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.14, 0.08, 0.1, 0.96)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.95, 0.4, 0.25, 1)
corner_radius_top_left = 16
corner_radius_top_right = 16
corner_radius_bottom_right = 16
corner_radius_bottom_left = 16
expand_margin_left = 24.0
expand_margin_top = 20.0
expand_margin_right = 24.0
expand_margin_bottom = 20.0

[node name="GameOver" type="CanvasLayer"]
process_mode = 3
layer = 12
script = ExtResource("1_game_over")

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.08, 0.02, 0.04, 0.72)

[node name="PanelContainer" type="PanelContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -220.0
offset_top = -220.0
offset_right = 220.0
offset_bottom = 220.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="VBox" type="VBoxContainer" parent="PanelContainer"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="PanelContainer/VBox"]
layout_mode = 2
theme_override_fonts/font = ExtResource("2_title_font")
