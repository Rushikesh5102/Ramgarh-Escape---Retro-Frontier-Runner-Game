[gd_scene load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/hud.gd" id="1_hud"]
[ext_resource type="FontFile" path="res://assets/fonts/ui_font.ttf" id="2_font"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_coin.png" id="3_coin"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_pause.png" id="4_pause"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_music.png" id="5_music"]
[ext_resource type="Texture2D" path="res://assets/sprites/collectible_jhumka.png" id="6_jhumka"]
[ext_resource type="Texture2D" path="res://assets/sprites/avatar_basanti.png" id="7_avatar"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_top"]
bg_color = Color(0.12, 0.08, 0.1, 0.8)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 16
corner_radius_bottom_left = 16
expand_margin_left = 12.0
expand_margin_top = 8.0
expand_margin_right = 12.0
expand_margin_bottom = 8.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bubble"]
bg_color = Color(0.10, 0.07, 0.12, 0.92)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.98, 0.78, 0.22, 1)
corner_radius_top_left = 16
corner_radius_top_right = 16
corner_radius_bottom_right = 16
corner_radius_bottom_left = 16
expand_margin_left = 14.0
expand_margin_top = 10.0
expand_margin_right = 14.0
expand_margin_bottom = 10.0

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="TopBar" type="MarginContainer" parent="."]
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 70.0
grow_horizontal = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 24

[node name="HBox" type="HBoxContainer" parent="TopBar"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="DistanceBox" type="PanelContainer" parent="TopBar/HBox"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_top")

[node name="DistanceLabel" type="Label" parent="TopBar/HBox/DistanceBox"]
layout_mode = 2
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 22
text = "0 m"

[node name="CoinBox" type="PanelContainer" parent="TopBar/HBox"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_top")

[node name="HBox" type="HBoxContainer" parent="TopBar/HBox/CoinBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="CoinIcon" type="TextureRect" parent="TopBar/HBox/CoinBox/HBox"]
custom_minimum_size = Vector2(26, 26)
layout_mode = 2
texture = ExtResource("3_coin")
expand_mode = 1
stretch_mode = 5

[node name="CoinLabel" type="Label" parent="TopBar/HBox/CoinBox/HBox"]
layout_mode = 2
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 22
text = "0"

[node name="FeverBox" type="PanelContainer" parent="TopBar/HBox"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_top")

[node name="HBox" type="HBoxContainer" parent="TopBar/HBox/FeverBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="JhumkaIcon" type="TextureRect" parent="TopBar/HBox/FeverBox/HBox"]
custom_minimum_size = Vector2(24, 24)
layout_mode = 2
texture = ExtResource("6_jhumka")
expand_mode = 1
stretch_mode = 5

[node name="FeverBar" type="ProgressBar" parent="TopBar/HBox/FeverBox/HBox"]
custom_minimum_size = Vector2(100, 16)
layout_mode = 2
size_flags_vertical = 4
max_value = 100.0
step = 1.0
show_percentage = false

[node name="FeverLabel" type="Label" parent="TopBar/HBox/FeverBox/HBox"]
layout_mode = 2
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(1, 0.85, 0.3, 1)
text = "DHANNO"

[node name="Spacer" type="Control" parent="TopBar/HBox"]
layout_mode = 2
size_flags_horizontal = 3

[node name="JukeboxButton" type="Button" parent="TopBar/HBox"]
custom_minimum_size = Vector2(160, 44)
layout_mode = 2
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(1, 0.9, 0.5, 1)
text = "🎵 Yeh Dosti"
icon = ExtResource("5_music")
expand_icon = true

[node name="PauseButton" type="TextureButton" parent="TopBar/HBox"]
custom_minimum_size = Vector2(44, 44)
layout_mode = 2
texture_normal = ExtResource("4_pause")
ignore_texture_size = true
stretch_mode = 5

[node name="DialogueContainer" type="Control" parent="."]
layout_mode = 3
anchors_preset = 0
offset_left = 180.0
offset_top = 260.0
offset_right = 680.0
offset_bottom = 350.0

[node name="DialogueBox" type="PanelContainer" parent="DialogueContainer"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_bubble")

[node name="HBox" type="HBoxContainer" parent="DialogueContainer/DialogueBox"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Avatar" type="TextureRect" parent="DialogueContainer/DialogueBox/HBox"]
custom_minimum_size = Vector2(56, 56)
layout_mode = 2
size_flags_vertical = 4
texture = ExtResource("7_avatar")
expand_mode = 1
stretch_mode = 5

[node name="VBox" type="VBoxContainer" parent="DialogueContainer/DialogueBox/HBox"]
layout_mode = 2
size_flags_horizontal = 3
alignment = 1

[node name="SpeakerLabel" type="Label" parent="DialogueContainer/DialogueBox/HBox/VBox"]
layout_mode = 2
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0.98, 0.78, 0.22, 1)
text = "Basanti:"

[node name="QuoteLabel" type="Label" parent="DialogueContainer/DialogueBox/HBox/VBox"]
layout_mode = 2
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 16
text = "Chal Dhanno! Aaj teri Basanti ki izzat ka sawal hai!"
autowrap_mode = 2

[node name="TapHint" type="Label" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -220.0
offset_top = -140.0
offset_right = 220.0
offset_bottom = -90.0
grow_horizontal = 2
grow_vertical = 2
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 24
theme_override_colors/font_color = Color(1, 0.9, 0.4, 0.95)
theme_override_colors/font_shadow_color = Color(0, 0, 0, 0.8)
theme_override_constants/shadow_offset_x = 2
theme_override_constants/shadow_offset_y = 2
text = "TAP SCREEN OR PRESS SPACE TO JUMP"
horizontal_alignment = 1
vertical_alignment = 1
